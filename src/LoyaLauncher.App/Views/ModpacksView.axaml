<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LoyaLauncher.App.ViewModels"
             xmlns:core="using:LoyaLauncher.Core"
             xmlns:motion="using:LoyaLauncher.App.Motion"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="640"
             x:Class="LoyaLauncher.App.Views.ModpacksView"
             x:DataType="vm:ModpacksViewModel">

    <Grid Margin="28,22">

        <DockPanel motion:Motion.RevealChildren="True">

            <!-- ============ 顶部：标题 + 工具栏 ============ -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Modpacks.Title}" Classes="hTitle"/>
                <TextBlock Text="{DynamicResource Modpacks.Subtitle}" Classes="hCaption" Margin="1,4,0,0"/>
            </StackPanel>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                <Button Grid.Column="0" Classes="AccentButton" Padding="20,9"
                        Content="{DynamicResource Modpacks.Import}"
                        Command="{Binding ImportCommand}"/>
                <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                           Text="{Binding StatusText}" Classes="hCaption"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" MaxHeight="34"/>
                <Button Grid.Column="2" Classes="GhostButton"
                        Content="{DynamicResource Modpacks.OpenFolder}"
                        Command="{Binding OpenExportFolderCommand}"
                        IsVisible="{Binding LastExportPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </Grid>

            <!-- ============ 进度条 ============ -->
            <ProgressBar DockPanel.Dock="Top" Classes="GlassProgress" Height="4"
                         IsVisible="{Binding IsBusy}"
                         Value="{Binding Progress}" Maximum="1"/>

            <!-- ============ 实例列表（可导出） ============ -->
            <Border Classes="GlassCard" Padding="6">
                <Grid>
                    <!-- 空状态 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding IsEmpty}">
                        <TextBlock Text="{DynamicResource Modpacks.Empty}" Classes="hBody"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Modpacks.EmptyHint}" Classes="hCaption"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Instances}" Background="Transparent"
                             IsVisible="{Binding !IsEmpty}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:GameInstance">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="14,9">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                            <Run Text="{Binding VersionId}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Loader}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                                            Background="#14FFFFFF" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="{Binding Edition}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <Button Grid.Column="2" Classes="GhostButton" Padding="14,7" FontSize="12"
                                            Content="{DynamicResource Modpacks.Export}"
                                            Command="{Binding $parent[UserControl].DataContext.ExportCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

        </DockPanel>
    </Grid>
</UserControl>
