<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LoyaLauncher.App.ViewModels"
             xmlns:conv="using:LoyaLauncher.App.Views"
             xmlns:motion="using:LoyaLauncher.App.Motion"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="640"
             x:Class="LoyaLauncher.App.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

    <UserControl.Resources>
        <conv:AccountKindToBadgeBrushConverter x:Key="KindBadgeBrush"/>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty"/>
    </UserControl.Resources>

    <Grid Margin="28,22" ColumnDefinitions="*,320" motion:Motion.RevealChildren="True">

        <!-- ============ 左：添加离线账户 ============ -->
        <StackPanel Grid.Column="0" Margin="0,0,18,0">
            <TextBlock Text="{DynamicResource Accounts.Title}" Classes="hTitle"/>
            <TextBlock Text="{DynamicResource Accounts.Subtitle}" Classes="hCaption" Margin="1,4,0,18"/>

            <Border Classes="GlassCard" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Accounts.AddTitle}" Classes="hSection" Margin="0,0,0,12"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Classes="GlassInput"
                                 PlaceholderText="{DynamicResource Accounts.NamePlaceholder}"
                                 Text="{Binding NewPlayerName}"/>
                        <Button Grid.Column="1" Classes="AccentButton" Margin="10,0,0,0"
                                Padding="22,10" Content="{DynamicResource Accounts.Add}"
                                Command="{Binding AddAccountCommand}"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Accounts.OfflineHint}" Classes="hCaption"
                               Margin="2,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusText}" Classes="hCaption" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ============ 右：账户列表 + 微软登录 ============ -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="{DynamicResource Accounts.List}" Classes="hSection" Margin="4,0,0,12"/>
            <Border Classes="GlassCard" Padding="6">
                <ListBox Background="Transparent" ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="12,10">
                                <Border Width="36" Height="36" CornerRadius="18"
                                        Background="{StaticResource AccentGradientBrush}">
                                    <TextBlock Text="👤" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlayerName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding PlayerUuid}" FontSize="9"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                </StackPanel>
                                <!-- 账户类型徽标 -->
                                <Border Grid.Column="2" CornerRadius="6" Padding="7,3"
                                        VerticalAlignment="Center"
                                        Background="{Binding Kind, Converter={StaticResource KindBadgeBrush}}">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Button Grid.Column="3" Classes="GhostButton" Padding="12,6"
                                        FontSize="11" Content="使用"
                                        Command="{Binding $parent[UserControl].DataContext.UseAccountCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="4" Classes="GhostButton" Padding="12,6"
                                        FontSize="11" Content="删除" Margin="6,0,0,0"
                                        Command="{Binding $parent[UserControl].DataContext.RemoveAccountCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ============ 微软正版登录 ============ -->
            <Border Classes="GlassCard" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Accounts.Microsoft.Title}" Classes="hSection"/>
                    <TextBlock Text="{DynamicResource Accounts.Microsoft.Subtitle}" Classes="hCaption"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <!-- 入口态：发起登录 -->
                    <StackPanel IsVisible="{Binding !IsMicrosoftLoginActive}" Margin="0,14,0,0">
                        <Button Classes="AccentButton" HorizontalAlignment="Left" Padding="22,10"
                                Content="{DynamicResource Accounts.Microsoft.Login}"
                                Command="{Binding LoginMicrosoftCommand}"
                                IsEnabled="{Binding !IsMicrosoftBusy}"/>
                        <TextBlock Text="{DynamicResource Accounts.Microsoft.Hint}" Classes="hCaption"
                                   TextWrapping="Wrap" Margin="2,10,0,0"/>
                    </StackPanel>

                    <!-- 设备码面板：等待授权 -->
                    <StackPanel IsVisible="{Binding IsMicrosoftLoginActive}" Margin="0,14,0,0">
                        <Border Background="#0DFFFFFF" CornerRadius="10" Padding="14,12"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Accounts.Microsoft.Step1}" Classes="hCaption"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding MicrosoftVerificationUri}" FontSize="13"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Classes="GhostButton" Padding="14,6" Margin="10,0,0,0" FontSize="11"
                                            Content="{DynamicResource Accounts.Microsoft.OpenBrowser}"
                                            Command="{Binding OpenMicrosoftVerificationCommand}"/>
                                </StackPanel>

                                <TextBlock Text="{DynamicResource Accounts.Microsoft.Step2}" Classes="hCaption"
                                           Margin="0,14,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border Background="#1AFFFFFF" CornerRadius="10" Padding="16,8">
                                        <TextBlock Text="{Binding MicrosoftUserCode}" FontSize="26"
                                                   FontWeight="Bold" LetterSpacing="4"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"/>
                                    </Border>
                                    <Button Classes="GhostButton" Padding="14,8" Margin="10,0,0,0"
                                            Content="{DynamicResource Accounts.Microsoft.Copy}"
                                            Command="{Binding CopyMicrosoftCodeCommand}"/>
                                </StackPanel>

                                <TextBlock Text="{DynamicResource Accounts.Microsoft.Step3}" Classes="hCaption"
                                           Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding MicrosoftStatus}" Classes="hCaption"
                                   Margin="2,10,0,0" TextWrapping="Wrap"/>
                        <Button Classes="GhostButton" HorizontalAlignment="Left" Padding="16,8"
                                Margin="0,10,0,0"
                                Content="{DynamicResource Accounts.Microsoft.Cancel}"
                                Command="{Binding CancelMicrosoftLoginCommand}"/>
                    </StackPanel>

                    <!-- 错误提示 -->
                    <TextBlock Text="{Binding MicrosoftError}" Classes="hCaption"
                               Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" Margin="2,12,0,0"
                               IsVisible="{Binding MicrosoftError, Converter={StaticResource StringNotEmpty}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
