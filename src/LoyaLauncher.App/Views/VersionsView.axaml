<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LoyaLauncher.App.ViewModels"
             xmlns:java="using:LoyaLauncher.Java"
             xmlns:motion="using:LoyaLauncher.App.Motion"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="640"
             x:Class="LoyaLauncher.App.Views.VersionsView"
             x:DataType="vm:VersionsViewModel">

    <Grid ColumnDefinitions="*,340" Margin="28,22" motion:Motion.RevealChildren="True">

        <!-- ============ 左：可下载版本 ============ -->
        <DockPanel Grid.Column="0" Margin="0,0,18,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Versions.Title}" Classes="hTitle"/>
                <TextBlock Text="{DynamicResource Versions.Subtitle}" Classes="hCaption" Margin="1,4,0,0"/>
            </StackPanel>

            <!-- 搜索与筛选 -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
                <TextBox Grid.Column="0" Classes="GlassInput" PlaceholderText="{DynamicResource Versions.SearchPlaceholder}"
                         Text="{Binding SearchText}"/>
                <ComboBox Grid.Column="1" Classes="GlassCombo" Margin="10,0,0,0" Width="110"
                          ItemsSource="{Binding TypeFilterOptions}"
                          SelectedItem="{Binding SelectedTypeFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Classes="GhostButton" Margin="10,0,0,0"
                        Command="{Binding LoadVersionsCommand}">
                    <TextBlock Text="{DynamicResource Versions.Refresh}"/>
                </Button>
            </Grid>

            <!-- 版本列表 -->
            <Border Classes="GlassCard" Padding="6">
                <Grid>
                    <ProgressBar Classes="GlassProgress" VerticalAlignment="Top"
                                 IsVisible="{Binding IsLoading}" IsIndeterminate="True"/>
                    <ListBox ItemsSource="{Binding FilteredVersions}" Background="Transparent"
                             SelectedItem="{Binding SelectedAvailable}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="java:ManifestVersion">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,8">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ReleaseTime, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                                            Background="#14FFFFFF" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="{Binding Type}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <Button Grid.Column="2" Classes="GhostButton" Padding="14,7"
                                            Content="安装"
                                            Command="{Binding $parent[UserControl].DataContext.InstallCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ============ 右：已安装 + 状态 ============ -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Versions.Installed}" Classes="hSection" Margin="4,0,0,12"/>

            <Border DockPanel.Dock="Top" Classes="GlassCard" Padding="14" Margin="0,0,0,14"
                    IsVisible="{Binding IsInstalling}">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxHeight="34"/>
                    <ProgressBar Classes="GlassProgress" Margin="0,10,0,0"
                                 Value="{Binding InstallProgress}" Maximum="1"/>
                    <Button Classes="GhostButton" Margin="0,10,0,0"
                            Content="取消" Command="{Binding CancelInstallCommand}"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Classes="GlassCard" Padding="14" Margin="0,0,0,14">
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" MaxHeight="60"/>
            </Border>

            <Border DockPanel.Dock="Bottom" Classes="GlassCard" Padding="12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Versions.InstalledList}" Classes="hSection" Margin="2,0,0,10"/>
                    <ListBox MaxHeight="300" Background="Transparent"
                             ItemsSource="{Binding InstalledVersions}"
                             SelectedItem="{Binding SelectedInstalled}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="java:InstalledVersionMeta">
                                <Grid ColumnDefinitions="*,Auto" Margin="8,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding JavaMajor, StringFormat='Java {0}'}"
                                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Classes="GhostButton" Padding="10,5" FontSize="11"
                                                Content="创建实例"
                                                Command="{Binding $parent[UserControl].DataContext.CreateInstanceCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="GhostButton" Padding="10,5" FontSize="11"
                                                Content="卸载" Margin="8,0,0,0"
                                                Command="{Binding $parent[UserControl].DataContext.UninstallCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
