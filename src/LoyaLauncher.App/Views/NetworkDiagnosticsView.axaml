<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LoyaLauncher.App.ViewModels"
             xmlns:conv="using:LoyaLauncher.App.Converters"
             xmlns:motion="using:LoyaLauncher.App.Motion"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="640"
             x:Class="LoyaLauncher.App.Views.NetworkDiagnosticsView"
             x:DataType="vm:NetworkDiagnosticsViewModel">

    <UserControl.Resources>
        <conv:DiagStateBrushConverter x:Key="DiagStateBrush"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="28,22">
        <Grid motion:Motion.RevealChildren="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题 + 操作 ============ -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Diagnostics.Title}" Classes="hTitle"/>
                    <TextBlock Text="{DynamicResource Diagnostics.Subtitle}" Classes="hCaption" Margin="1,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="GhostButton" Padding="16,8" Margin="0,0,10,0"
                            Content="{DynamicResource Diagnostics.OpenLogs}"
                            Click="OnOpenLogDirectory"/>
                    <Button Classes="GhostButton" Padding="16,8" Margin="0,0,10,0"
                            Content="{DynamicResource Diagnostics.CopyReport}"
                            Click="OnCopyReport"/>
                    <Button Classes="AccentButton" Padding="18,8"
                            Content="{DynamicResource Diagnostics.RunAll}"
                            Command="{Binding RunAllCommand}"
                            IsVisible="{Binding !IsRunning}"/>
                    <Button Classes="AccentButton" Padding="18,8"
                            Content="{DynamicResource Diagnostics.Testing}"
                            IsEnabled="False"
                            IsVisible="{Binding IsRunning}"/>
                </StackPanel>
            </Grid>

            <!-- ============ 探测结果表 ============ -->
            <Border Grid.Row="1" Classes="GlassCard" Padding="6" Margin="0,0,0,14">
                <Grid RowDefinitions="Auto,*">
                    <!-- 表头（底部分隔线） -->
                    <Border Grid.Row="0" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Margin="10,8,10,0">
                        <Grid Margin="6,0,6,8" ColumnDefinitions="*,150,110,Auto">
                            <TextBlock Grid.Column="0" Text="{DynamicResource Diagnostics.ColSource}" Classes="hCaption"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Diagnostics.ColState}" Classes="hCaption"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Diagnostics.ColResult}" Classes="hCaption"/>
                        </Grid>
                    </Border>
                    <!-- 行 -->
                    <ListBox Grid.Row="1" Background="Transparent" ItemsSource="{Binding Targets}"
                             SelectedItem="{Binding SelectedTarget}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiagItem">
                                <Grid Margin="16,9" ColumnDefinitions="*,150,110,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding DisplayUrl}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Margin="0,0,8,0"
                                                 Fill="{Binding State, Converter={StaticResource DiagStateBrush}}"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{Binding State, Converter={StaticResource DiagStateBrush}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ResultText}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Button Grid.Column="3" Classes="GhostButton" Padding="12,5" FontSize="11"
                                            VerticalAlignment="Center"
                                            Content="{DynamicResource Diagnostics.TestOne}"
                                            Command="{Binding $parent[UserControl].DataContext.TestOneCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 选中行的失败详情 / 汇总状态 -->
            <TextBlock Grid.Row="2" Text="{Binding SelectedErrorText}" Classes="hCaption"
                       Margin="2,0,0,10" TextWrapping="Wrap"
                       Foreground="{StaticResource ErrorBrush}"
                       IsVisible="{Binding SelectedErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Grid.Row="2" Text="{Binding StatusText}" Classes="hCaption"
                       Margin="2,0,0,12" TextWrapping="Wrap"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- ============ 近期请求 ============ -->
            <Border Grid.Row="3" Classes="GlassCard" Padding="6">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{DynamicResource Diagnostics.Recent}"
                               Classes="hSection" Margin="14,12,14,10"/>
                    <Grid Grid.Row="1">
                        <ListBox Background="Transparent" ItemsSource="{Binding RecentLogs}" MaxHeight="260">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NetLogItem">
                                    <Grid Margin="14,6" ColumnDefinitions="70,110,90,110,*,70,50">
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Module}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Stage}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Result}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Host}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Duration}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Status}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{DynamicResource Diagnostics.NoLogs}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   IsVisible="{Binding !HasRecentLogs}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ 隐私说明 ============ -->
            <TextBlock Grid.Row="4" Text="{DynamicResource Diagnostics.PrivacyHint}"
                       Classes="hCaption" Margin="2,12,0,0" TextWrapping="Wrap"/>
        </Grid>
    </ScrollViewer>
</UserControl>
