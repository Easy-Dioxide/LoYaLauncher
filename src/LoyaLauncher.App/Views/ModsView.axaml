<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LoyaLauncher.App.ViewModels"
             xmlns:motion="using:LoyaLauncher.App.Motion"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="640"
             x:Class="LoyaLauncher.App.Views.ModsView"
             x:DataType="vm:ModsViewModel">

    <Grid Margin="28,22" motion:Motion.RevealChildren="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 标题 ============ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource Mods.Title}" Classes="hTitle"/>
                <TextBlock Text="{DynamicResource Mods.Subtitle}" Classes="hCaption" Margin="1,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Mods.Instance}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                <ComboBox Classes="GlassCombo" Width="180"
                          ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ============ 加载器安装条 ============ -->
        <Border Grid.Row="1" Classes="GlassCard" Padding="16,12" Margin="0,16,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Text="{DynamicResource Mods.Loader}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Classes="GlassCombo" Margin="10,0,0,0" Width="130"
                          ItemsSource="{Binding Loaders}"
                          SelectedItem="{Binding SelectedLoader}"/>
                <Button Grid.Column="3" Classes="AccentButton" Padding="22,9"
                        Content="{DynamicResource Mods.InstallLoader}"
                        Command="{Binding InstallLoaderCommand}"/>
            </Grid>
        </Border>

        <!-- ============ 主内容：搜索 + 已装 ============ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,320" Margin="0,16,0,0">

            <!-- 左：Modrinth 搜索 -->
            <DockPanel Grid.Column="0" Margin="0,0,18,0">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <TextBox Grid.Column="0" Classes="GlassInput"
                             PlaceholderText="{DynamicResource Mods.SearchPlaceholder}"
                             Text="{Binding SearchQuery}"/>
                    <Button Grid.Column="1" Classes="AccentButton" Margin="10,0,0,0" Padding="20,9"
                            Content="{DynamicResource Mods.Search}"
                            Command="{Binding SearchCommand}"/>
                </Grid>

                <Border DockPanel.Dock="Bottom" Classes="GlassCard" Padding="14" Margin="0,14,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>

                <Border Classes="GlassCard" Padding="6">
                    <ListBox Background="Transparent" ItemsSource="{Binding SearchResults}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,10">
                                    <Border Width="42" Height="42" CornerRadius="8"
                                            Background="#14FFFFFF">
                                        <TextBlock Text="🧩" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="GhostButton" Padding="14,7"
                                            VerticalAlignment="Center"
                                            Content="安装"
                                            Command="{Binding $parent[UserControl].DataContext.InstallModCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- 右：已安装 Mod -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Mods.Installed}" Classes="hSection"
                           Margin="4,0,0,12"/>
                <Border Classes="GlassCard" Padding="6">
                    <ListBox Background="Transparent" ItemsSource="{Binding InstalledMods}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="10,8">
                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{Binding StatusBrush}"/>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Version}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="GhostButton" Padding="9,5"
                                            FontSize="11" Content="启停" VerticalAlignment="Center"
                                            Command="{Binding $parent[UserControl].DataContext.ToggleModCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="3" Classes="GhostButton" Padding="9,5"
                                            FontSize="11" Content="删除" Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[UserControl].DataContext.DeleteModCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
